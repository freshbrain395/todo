{
  "name": "todo-agent-root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c magenta,cyan \"uv run todo server\" \"pnpm --dir front dev\"",
    "dev:backend": "uv run todo server",
    "dev:frontend": "pnpm --dir front dev",
    "cli": "uv run todo",
    "gui": "uv run python run.py gui",
    "web": "uv run python run.py web",
    "build": "pnpm --dir front build",
    "build:exe": "uv run python build.py exe",
    "build:installer": "uv run python build.py installer",
    "build:release": "uv run python build.py",
    "preview": "pnpm --dir front preview",
    "test": "pnpm --dir front test",
    "test:backend": "uv run python -m pytest backend/tests",
    "test:all": "pnpm --dir front test && uv run python -m pytest backend/tests"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
